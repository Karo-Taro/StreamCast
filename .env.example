# Окружение StreamCast (скопируй в .env и подставь свои значения).
# Всё необязательно: без файла приложение запустится с безопасными дефолтами
# и при первом старте само попросит задать пароль администратора.

# --- Безопасность -----------------------------------------------------------

# Пароль администратора. Если не задан (или оставлен changeme), при первом
# старте приложение покажет экран создания пароля — проще ничего не трогать.
# STREAMCAST_PASSWORD=changeme

# Секрет сессий Flask. Если не задан — генерируется случайный и хранится в БД.
# STREAMCAST_SECRET=long-random-string

# Требовать ли вход по паролю (1/0). Автоматически включается после первого
# запуска; выключайте только если панель нужна открытой для чтения.
# STREAMCAST_REQUIRE_LOGIN=1

# Доверять заголовкам X-Real-IP / CF-Connecting-IP / X-Forwarded-Proto от
# обратного прокси (nginx, Cloudflare). Ставьте 0, если приложение смотрит
# в интернет напрямую, без прокси.
# STREAMCAST_TRUST_PROXY=1

# --- Сеть -------------------------------------------------------------------

# Куда биндится встроенный dev-сервер (для gunicorn задаётся его -b).
# STREAMCAST_HOST=127.0.0.1
# STREAMCAST_PORT=5000

# --- Стриминг ---------------------------------------------------------------

# База приёма YouTube. В интерфейсе вставляется только КЛЮЧ трансляции.
# STREAMCAST_RTMP_BASE=rtmp://a.rtmp.youtube.com/live2

# Формат выхода для 24/7-стрима (все загрузки нормализуются под него).
STREAMCAST_WIDTH=1920
STREAMCAST_HEIGHT=1080
STREAMCAST_FPS=30
STREAMCAST_VBITRATE=4500k
STREAMCAST_ABITRATE=128k

# Отклонять видео с частотой кадров >= этого значения (60fps ломает склейку).
# STREAMCAST_MAX_FPS=60

# Лимит размера загрузки, МБ.
# STREAMCAST_MAX_UPLOAD_MB=8192

# Подхват правок очереди в эфире: длина «блока» проигрывания в секундах.
# STREAMCAST_RELOAD_BLOCK_SECONDS=900

# Сколько YouTube держит эфир без данных, прежде чем закрыть его (сек).
# STREAMCAST_YOUTUBE_GRACE_SECONDS=60

# Пути к ffmpeg/ffprobe, если они не в PATH.
# STREAMCAST_FFMPEG=ffmpeg
# STREAMCAST_FFPROBE=ffprobe

# --- Хранилище --------------------------------------------------------------

# Где лежат загрузки / кодированные файлы / БД. По умолчанию ./storage.
# Дополнительные хранилища (внешний SSD и т.п.) добавляются в админ-панели.
# STREAMCAST_STORAGE=/var/lib/streamcast

# Хранилище перестаёт принимать новые файлы, когда на его диске меньше
# этого объёма свободного места (ГБ); загрузки уходят на другие хранилища.
# STREAMCAST_MIN_FREE_GB=5

# Перезапускать трансляции, которые были live перед остановкой сервера (1/0).
# STREAMCAST_AUTORESUME=1

# Public base URL of the panel (no trailing slash) — OAuth redirect base:
# <SITE_URL>/oauth2callback must be registered in Google Cloud.
# STREAMCAST_SITE_URL=https://streamcast.stream
